<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Phiên bản model chuẩn của Maven -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Thông tin cơ bản của project -->
    <groupId>org.example</groupId>
    <artifactId>AuctionSystem</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- Các thuộc tính chung của project -->
    <properties>
        <!-- Dùng Java 17 để compile -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- Encoding của project -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Version JavaFX dùng trong project -->
        <javafx.version>21.0.2</javafx.version>
    </properties>

    <!-- Thư viện phụ thuộc -->
    <dependencies>

        <!-- Thư viện JavaFX controls:
             dùng cho Button, Label, TextField, PasswordField, VBox... -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Thư viện JavaFX FXML:
             dùng để load file giao diện .fxml -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- SQLite JDBC:
             dùng để kết nối database SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.41.2.1</version>
        </dependency>

        <!-- Gson:
             dùng để xử lý JSON nếu cần -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
    </dependencies>

    <!-- Build plugin -->
    <build>
        <plugins>

            <!-- Plugin compile Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- Plugin chạy JavaFX bằng Maven -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Class khởi động chính của app -->
                    <mainClass>org.example.Main</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>