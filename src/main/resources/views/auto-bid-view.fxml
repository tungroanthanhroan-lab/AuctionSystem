<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.AutoBidController"
      stylesheets="@/styles/style.css"
      spacing="16"
      style="-fx-padding: 32 36 32 36;
             -fx-background-color: linear-gradient(to bottom right, #e0f2fe, #f8fafc);
             -fx-min-width: 380;
             -fx-max-width: 420;">

    <!-- Header -->
    <Label text="🤖 Đặt giá tự động"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1e293b;"
           alignment="CENTER"
           maxWidth="Infinity"/>

    <Label fx:id="lblAuctionTitle"
           text="Phiên: --"
           styleClass="subtitle-label"
           alignment="CENTER"
           maxWidth="Infinity"/>

    <Label fx:id="lblCurrentPrice"
           text="Giá hiện tại: 0 $"
           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"
           alignment="CENTER"
           maxWidth="Infinity"/>

    <Separator/>

    <!-- Mô tả -->
    <Label text="Hệ thống sẽ tự động đặt giá thay bạn mỗi khi có người vượt qua,&#10;đến khi đạt giá tối đa."
           wrapText="true"
           style="-fx-font-size: 12px; -fx-text-fill: #64748b;"
           maxWidth="Infinity"/>

    <!-- Giá tối đa -->
    <VBox spacing="4">
        <Label text="Giá tối đa (maxBid) $"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <TextField fx:id="txtMaxBid"
                   promptText="Ví dụ: 500"
                   prefHeight="40"
                   maxWidth="Infinity"/>
        <Label text="Giới hạn cao nhất bạn chấp nhận trả"
               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
    </VBox>

    <!-- Bước giá -->
    <VBox spacing="4">
        <Label text="Bước giá (increment) $"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <TextField fx:id="txtIncrement"
                   promptText="Ví dụ: 10"
                   prefHeight="40"
                   maxWidth="Infinity"/>
        <Label text="Mỗi lần tự động trả giá tăng thêm bao nhiêu"
               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
    </VBox>

    <!-- Status label -->
    <Label fx:id="lblStatus"
           text=""
           wrapText="true"
           maxWidth="Infinity"
           style="-fx-font-size: 12px; -fx-font-weight: bold;
                  -fx-padding: 8 12 8 12;
                  -fx-background-radius: 6;"/>

    <Separator/>

    <!-- Buttons -->
    <Button fx:id="btnActivate"
            text="Kích hoạt Auto-Bid"
            styleClass="primary-button"
            maxWidth="Infinity"
            prefHeight="44"
            onAction="#handleActivate"/>

    <HBox spacing="10">
        <Button fx:id="btnCancel"
                text="Hủy Auto-Bid"
                styleClass="danger-button"
                HBox.hgrow="ALWAYS"
                maxWidth="Infinity"
                prefHeight="40"
                disable="true"
                onAction="#handleCancel"/>

        <Button fx:id="btnClose"
                text="Đóng"
                styleClass="secondary-button"
                HBox.hgrow="ALWAYS"
                maxWidth="Infinity"
                prefHeight="40"
                onAction="#handleClose"/>
    </HBox>

</VBox>
