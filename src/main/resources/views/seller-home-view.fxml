<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.SellerHomeController"
           stylesheets="@/styles/style.css"
           prefWidth="620"
           prefHeight="500">

    <VBox alignment="CENTER"
          spacing="18"
          styleClass="page-container"
          maxWidth="420"
          prefHeight="360">

        <Label text="Trang người bán"
               styleClass="title-label"/>

        <Label fx:id="lblWelcome"
               text="Xin chào Seller"
               styleClass="subtitle-label"/>

        <Label text="Tạo phiên đấu giá mới để người mua có thể tham gia đặt giá."
               styleClass="subtitle-label"
               wrapText="true"
               alignment="CENTER"
               textAlignment="CENTER"
               maxWidth="320"/>

        <Button fx:id="btnCreateAuction"
                text="Tạo phiên đấu giá mới"
                styleClass="primary-button"
                onAction="#handleOpenCreateAuction"/>

        <Button fx:id="btnBackToLogin"
                text="Đăng xuất"
                styleClass="danger-button"
                onAction="#handleBackToLogin"/>

    </VBox>

</StackPane>