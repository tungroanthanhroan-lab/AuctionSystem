<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.BiddingController"
            stylesheets="@/styles/style.css"
            style="-fx-background-color: linear-gradient(to bottom right, #e0f2fe, #f8fafc);">

    <center>
        <HBox spacing="0"
              style="-fx-padding: 24; -fx-alignment: CENTER;"
              BorderPane.alignment="CENTER">

            <!-- ══ LEFT PANEL — form + history list ══════════════════════ -->
            <VBox spacing="12"
                  styleClass="panel-card"
                  prefWidth="360"
                  minWidth="320"
                  maxWidth="400"
                  style="-fx-padding: 32 28 32 28;">

                <Label fx:id="lblTenSanPham"
                       text="Sản phẩm: Chưa chọn"
                       styleClass="title-label"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       wrapText="true"
                       maxWidth="320"/>

                <Label fx:id="lblGiaHienTai"
                       text="Giá hiện tại: 0 $"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>

                <Label fx:id="lblNguoiDanDau"
                       text="Người dẫn đầu: Chưa có"
                       styleClass="subtitle-label"
                       alignment="CENTER"
                       textAlignment="CENTER"/>

                <Label fx:id="lblTrangThai"
                       text="Trạng thái: ĐANG MỞ"
                       styleClass="status-open"
                       alignment="CENTER"
                       textAlignment="CENTER"/>

                <Label fx:id="lblCountdown"
                       text="Thời gian còn lại: --:--:--"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       style="-fx-text-fill: #f59e0b; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <TextField fx:id="txtNhapGia"
                           promptText="Nhập giá tiền ($)"
                           prefHeight="42"
                           maxWidth="260"
                           onAction="#handleDatGia"/>

                <Button fx:id="btnDatGia"
                        text="Đặt giá ngay"
                        styleClass="primary-button"
                        defaultButton="true"
                        onAction="#handleDatGia"/>

                <Label text="Lịch sử đấu giá"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                <ListView fx:id="listLichSuBid"
                          maxWidth="320"
                          VBox.vgrow="ALWAYS"
                          prefHeight="200"/>

                <Button fx:id="btnDongPhien"
                        text="Đóng phiên"
                        styleClass="danger-button"
                        onAction="#handleDongPhien"/>

                <Button fx:id="btnQuayLai"
                        text="Quay lại danh sách"
                        styleClass="secondary-button"
                        onAction="#handleBackToAuctionList"/>

            </VBox>

            <!-- ══ RIGHT PANEL — realtime chart ══════════════════════════ -->
            <VBox spacing="10"
                  styleClass="panel-card"
                  HBox.hgrow="ALWAYS"
                  style="-fx-padding: 32 28 32 28; -fx-margin: 0 0 0 20;"
                  VBox.vgrow="ALWAYS">

                <Label text="Biểu đồ giá theo thời gian thực"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                       alignment="CENTER"
                       textAlignment="CENTER"
                       maxWidth="Infinity"/>

                <LineChart fx:id="bidChart"
                           styleClass="bid-chart"
                           animated="false"
                           createSymbols="true"
                           legendVisible="false"
                           VBox.vgrow="ALWAYS"
                           maxWidth="Infinity"
                           maxHeight="Infinity">

                    <xAxis>
                        <NumberAxis fx:id="xAxis"
                                    label="Thời gian (giây)"
                                    autoRanging="true"/>
                    </xAxis>

                    <yAxis>
                        <NumberAxis fx:id="yAxis"
                                    label="Giá ($)"
                                    autoRanging="true"
                                    forceZeroInRange="false"/>
                    </yAxis>

                </LineChart>

            </VBox>

        </HBox>
    </center>

</BorderPane>
