<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.BiddingController"
           stylesheets="@/styles/style.css"
           prefWidth="760"
           prefHeight="680">

    <VBox alignment="CENTER"
          spacing="14"
          styleClass="page-container"
          maxWidth="620"
          prefHeight="580">

        <Label fx:id="lblTenSanPham"
               text="Sản phẩm: Chưa chọn"
               styleClass="title-label"
               alignment="CENTER"
               textAlignment="CENTER"
               wrapText="true"
               maxWidth="520"/>

        <Label fx:id="lblGiaHienTai"
               text="Giá hiện tại: 0 $"
               alignment="CENTER"
               textAlignment="CENTER"
               maxWidth="520"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>

        <Label fx:id="lblNguoiDanDau"
               text="Người dẫn đầu: Chưa có"
               styleClass="subtitle-label"
               alignment="CENTER"
               textAlignment="CENTER"
               maxWidth="520"/>

        <Label fx:id="lblTrangThai"
               text="Trạng thái: ĐANG MỞ"
               styleClass="status-open"
               alignment="CENTER"
               textAlignment="CENTER"
               maxWidth="520"/>
        <Label fx:id="lblCountdown"
               text="Thời gian còn lại: --:--:--"
               alignment="CENTER"
               textAlignment="CENTER"
               style="-fx-text-fill: #f59e0b; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        <TextField fx:id="txtNhapGia"
                   promptText="Nhập giá tiền ($)"
                   prefWidth="260"
                   prefHeight="42"
                   onAction="#handleDatGia"/>

        <Button fx:id="btnDatGia"
                text="Đặt giá ngay"
                styleClass="primary-button"
                defaultButton="true"
                onAction="#handleDatGia"/>

        <Label text="Lịch sử đấu giá"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

        <ListView fx:id="listLichSuBid"
                  prefWidth="520"
                  prefHeight="170"/>

        <Button fx:id="btnDongPhien"
                text="Đóng phiên"
                styleClass="danger-button"
                onAction="#handleDongPhien"/>

        <Button fx:id="btnQuayLai"
                text="Quay lại danh sách"
                styleClass="secondary-button"
                onAction="#handleBackToAuctionList"/>

    </VBox>

</StackPane>