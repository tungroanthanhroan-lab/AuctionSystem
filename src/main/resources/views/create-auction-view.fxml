<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.CreateAuctionController"
           stylesheets="@/styles/style.css"
           prefWidth="620"
           prefHeight="560">

    <VBox alignment="CENTER"
          spacing="18"
          styleClass="page-container"
          maxWidth="440"
          prefHeight="430">

        <Label text="Tạo phiên đấu giá"
               styleClass="title-label"/>

        <Label text="Nhập thông tin sản phẩm, giá khởi điểm và thời gian kết thúc"
               styleClass="subtitle-label"
               alignment="CENTER"
               textAlignment="CENTER"
               wrapText="true"
               maxWidth="340"/>

        <TextField fx:id="txtAuctionName"
                   promptText="Tên sản phẩm / phiên đấu giá"
                   prefWidth="260"
                   prefHeight="42"/>

        <TextField fx:id="txtStartPrice"
                   promptText="Giá khởi điểm ($)"
                   prefWidth="260"
                   prefHeight="42"/>

        <DatePicker fx:id="datePickerEndDate"
                    promptText="Chọn ngày kết thúc"
                    prefWidth="260"
                    prefHeight="42"/>

        <HBox spacing="10" alignment="CENTER">
            <ComboBox fx:id="cbHour"
                      promptText="Giờ"
                      prefWidth="125"
                      prefHeight="42"/>

            <ComboBox fx:id="cbMinute"
                      promptText="Phút"
                      prefWidth="125"
                      prefHeight="42"/>
        </HBox>

        <Button fx:id="btnCreate"
                text="Tạo phiên"
                styleClass="primary-button"
                defaultButton="true"
                onAction="#handleCreateAuction"/>

        <Button fx:id="btnBack"
                text="Quay lại"
                styleClass="secondary-button"
                onAction="#handleBackToHome"/>

    </VBox>

</StackPane>