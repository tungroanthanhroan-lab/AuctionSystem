<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.CreateAuctionController"
           stylesheets="@/styles/style.css"
           prefWidth="620"
           prefHeight="520">

    <VBox alignment="CENTER"
          spacing="18"
          styleClass="page-container"
          maxWidth="420"
          prefHeight="390">

        <Label text="Tạo phiên đấu giá"
               styleClass="title-label"/>

        <Label text="Nhập thông tin sản phẩm và giá khởi điểm"
               styleClass="subtitle-label"
               alignment="CENTER"
               textAlignment="CENTER"
               wrapText="true"
               maxWidth="320"/>

        <TextField fx:id="txtAuctionName"
                   promptText="Tên sản phẩm / phiên đấu giá"
                   prefWidth="260"
                   prefHeight="42"/>

        <TextField fx:id="txtStartPrice"
                   promptText="Giá khởi điểm ($)"
                   prefWidth="260"
                   prefHeight="42"/>

        <Button fx:id="btnCreate"
                text="Tạo phiên"
                styleClass="primary-button"
                defaultButton="true"
                onAction="#handleCreateAuction"/>

        <Button fx:id="btnBack"
                text="Quay lại"
                styleClass="secondary-button"
                onAction="#handleBackToSellerHome"/>

    </VBox>

</StackPane>