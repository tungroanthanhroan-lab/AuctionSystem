<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.CreateAuctionController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Tạo phiên đấu giá mới"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtAuctionName"
               promptText="Tên sản phẩm / phiên đấu giá"/>
    <TextField fx:id="txtStartPrice"
               promptText="Giá khởi điểm ($)"/>

    <Button fx:id="btnCreate"
            text="TẠO PHIÊN"
            onAction="#handleCreateAuction"/>

    <Button fx:id="btnBack"
            text="QUAY LẠI"
            onAction="#handleBackToSellerHome"/>

</VBox>