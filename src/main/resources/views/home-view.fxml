<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.HomeController"
           stylesheets="@/styles/style.css"
           prefWidth="620"
           prefHeight="520">

    <VBox alignment="CENTER"
          spacing="18"
          styleClass="page-container"
          maxWidth="420"
          prefHeight="390">

        <Label fx:id="welcomeLabel"
               text="Chào mừng đến với Auction System"
               styleClass="title-label"
               wrapText="true"
               alignment="CENTER"
               textAlignment="CENTER"
               maxWidth="340"/>

        <Label text="Bạn có thể tham gia đấu giá hoặc tạo phiên đấu giá mới."

               styleClass="subtitle-label"
               wrapText="true"
               alignment="CENTER"
               textAlignment="CENTER"
               maxWidth="320"/>
        <Label fx:id="balanceLabel"
               text="Thông tin ví: Đang tải..."
               style="-fx-font-weight: bold; -fx-text-fill: #2e7d32;"
               wrapText="true"
               alignment="CENTER"/>
        <Button text="Tham gia đấu giá"
                styleClass="primary-button"
                onAction="#handleViewAuctions"/>

        <Button text="Tạo phiên đấu giá"
                styleClass="secondary-button"
                onAction="#handleOpenCreateAuction"/>
        <Button fx:id="btnMyAuctions"
                text="Phiên của tôi"
                styleClass="secondary-button"
                prefWidth="220"
                prefHeight="42"
                onAction="#handleMyAuctions"/>
        <Button fx:id="btnCheckBalance"
                text="Kiểm tra số dư"
                styleClass="secondary-button"
                prefWidth="220"
                prefHeight="42"
                onAction="#handleCheckBalance"/>

        <Button fx:id="btnDeposit"
                text="Nạp tiền"
                styleClass="secondary-button"
                prefWidth="220"
                prefHeight="42"
                onAction="#handleDeposit"/>
        <Button fx:id="btnChangePassword"
                text="Đổi mật khẩu"
                styleClass="secondary-button"
                prefWidth="220"
                prefHeight="42"
                onAction="#handleChangePassword"/>
        <Button text="Đăng xuất"
                styleClass="danger-button"
                onAction="#handleLogout"/>

    </VBox>

</StackPane>